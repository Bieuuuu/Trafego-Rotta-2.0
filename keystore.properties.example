# Configurações de Assinatura de Release do Android (Trafego Rotta)
# Copie este arquivo para "keystore.properties" e preencha com seus dados locais.
# NUNCA commite o arquivo "keystore.properties" nem o arquivo .keystore no controle de versão!

# Caminho relativo ou absoluto para o arquivo de chave (.keystore ou .jks)
storeFile=../release.keystore

# Senha da Keystore
storePassword=SuaSenhaDaKeystoreAqui

# Alias da chave (ex: traffigorotta)
keyAlias=traffigorotta

# Senha do Alias
keyPassword=SuaSenhaDoAliasAqui
